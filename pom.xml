<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.graphqlguy</groupId>
	<artifactId>moviedb-agents</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>graphQLMovieDB-agents</name>
	<description>Companion for the GraphQL for AI Agents course, Java edition: agents built against the Movie Database GraphQL service</description>

	<properties>
		<java.version>21</java.version>
		<langchain4j.version>1.19.0</langchain4j.version>
		<!-- Pinned explicitly: the Maven release tag currently points at a 1.9.0 beta,
		     and the course pins stable versions only. -->
		<langgraph4j.version>1.8.24</langgraph4j.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>2.0.1</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<!-- RestClient for talking to the moviedb GraphQL endpoint; JSON support for
		     tool input/output and the emitted catalog -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-json</artifactId>
		</dependency>
		<!-- ToolCallback and ToolDefinition, the contract every Spring AI chat model consumes -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-model</artifactId>
		</dependency>
		<!-- The local chat model driving the agent command (any tool-calling model Ollama serves) -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-ollama</artifactId>
		</dependency>
		<!-- LangChain4j, the second JVM agent framework this course teaches. The plain
		     GA libraries, deliberately: the Boot 4 starters exist but are beta-versioned
		     as of August 2026, and the course pins GA artifacts only. -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j</artifactId>
			<version>${langchain4j.version}</version>
		</dependency>
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-ollama</artifactId>
			<version>${langchain4j.version}</version>
		</dependency>
		<!-- LangGraph4j: the agent's control flow as an explicit, typed state machine -->
		<dependency>
			<groupId>org.bsc.langgraph4j</groupId>
			<artifactId>langgraph4j-core</artifactId>
			<version>${langgraph4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.bsc.langgraph4j</groupId>
			<artifactId>langgraph4j-langchain4j</artifactId>
			<version>${langgraph4j.version}</version>
		</dependency>
		<!-- Schema parsing and the introspection walk -->
		<dependency>
			<groupId>com.graphql-java</groupId>
			<artifactId>graphql-java</artifactId>
			<version>25.0</version>
		</dependency>
		<!-- Spring AI's progressive tool disclosure: the ToolSearchToolCallingAdvisor
		     and its three tool indexes. Brings Lucene with it. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-tool-search-advisor</artifactId>
		</dependency>
		<!-- The course's fixed token yardstick -->
		<dependency>
			<groupId>com.knuddels</groupId>
			<artifactId>jtokkit</artifactId>
			<version>1.1.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- SimpleVectorStore, so the tool-search benchmark can measure the vector
		     index beside the regex and Lucene ones. Embeddings come from Ollama. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-vector-store</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Netty loads a native library when the embedding client starts, and
					     the JVM prints a restricted-method warning unless native access is
					     granted. The warning goes to the console before any logger exists,
					     so it is silenced here rather than in logback-spring.xml. -->
					<jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<!-- reactor-netty already ships Netty's native macOS DNS resolver, but only the
		     Intel build (osx-x86_64), which cannot load on Apple silicon: Netty then logs
		     an ERROR at startup and falls back to the JDK resolver. This profile adds the
		     matching aarch64 binary, and it activates only on an Apple-silicon Mac, so
		     Intel Macs, Linux and Windows resolve exactly what they resolved before.
		     The version comes from Spring Boot's Netty BOM. -->
		<profile>
			<id>macos-apple-silicon</id>
			<activation>
				<os><family>mac</family><arch>aarch64</arch></os>
			</activation>
			<dependencies>
				<dependency>
					<groupId>io.netty</groupId>
					<artifactId>netty-resolver-dns-native-macos</artifactId>
					<classifier>osx-aarch_64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>

</project>
